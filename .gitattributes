* text=auto
*.glb binary
*.pdf binary
*.wav binary
*.mp3 binary
*.zip binary
*.svg text
*.html text
# Markdown uses trailing double spaces for deliberate hard line breaks.
*.md text whitespace=-blank-at-eol,-blank-at-eof
# Run log: one JSON line per step; concurrent appends from two clones are both kept.
daily/runs/log.jsonl merge=union
